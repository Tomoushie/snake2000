# Build output (rebuild from source with csc.exe or the .NET SDK)
*.exe
*.pdb
*.dll
bin/
obj/

# Raccourcis Windows locaux (pointent vers des chemins de la machine)
*.lnk

# Editor/tooling-specific local config (never commit secrets like API keys)
.vscode/
.continue/
*.csproj.user

# Sorties du diagnostic : regenerees a chaque `python Tools/diagnostic.py`,
# elles salissaient `git status` apres chaque mesure.
Tools/diag.rsp
Tools/diag_erreurs.txt

# Historique local de l editeur.
.history/
